{
  "name": "api",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run build && bun ./dist/index.js",
    "dev": "bun run --watch ./src/index.ts",
    "build": "bun run clean && tsc && bun build src/index.ts --outdir dist --minify --target bun",
    "clean": "bunx rimraf dist",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3 || ^6.0.0"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "hono": "^4.12.26"
  }
}
